          "text": "#!/bin/bash\n#SBATCH --job-name=scfdiag_ec_li\n#SBATCH --partition=hpxg\n#SBATCH --nodes=1\n#SBATCH --ntasks=4\n#SBATCH --cpus-per-task=1\n#SBATCH --time=00:05:00\n#SBATCH --array=0-2%1\n#SBATCH --no-requeue\n#SBATCH --output=slurm-%A_%a.out\nset -euo pipefail\nmodule load openmpi/5.0\nsource \"$HOME/project/soft/orca/env.sh\"\nexport OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1\ntest \"${SLURM_NTASKS}\" = 4\ncd \"${SLURM_SUBMIT_DIR}\"\nsha256sum -c PACKAGE_SHA256SUMS\ntask=$(sed -n \"$((SLURM_ARRAY_TASK_ID + 1))p\" batch_1.txt)\ntest -n \"$task\"\ncd \"$task\"\nsha256sum -c inputs.sha256\nmkdir -p attempts\nrun_dir=\"attempts/${SLURM_ARRAY_JOB_ID}_${SLURM_ARRAY_TASK_ID}_${SLURM_RESTART_COUNT:-0}\"\nmkdir \"$run_dir\"\ncp geom.xyz job.inp \"$run_dir/\"\ncd \"$run_dir\"\nmkdir mpi_tmp\nexport TMPDIR=\"$PWD/mpi_tmp\"\nexport PRTE_MCA_prte_tmpdir_base=\"$TMPDIR\" PMIX_MCA_pmix_tmpdir_base=\"$TMPDIR\"\ndate -u +%FT%TZ > started.utc\n\"$ORCA_DIR/orca\" job.inp > job.log 2> job.stderr\ngrep -q 'ORCA TERMINATED NORMALLY' job.log\ntest -s job.gbw\n\"$ORCA_DIR/orca_2mkl\" job -molden > job_2mkl.out 2> job_2mkl.err\ntest -s job.molden.input\nsha256sum geom.xyz job.inp job.log job.stderr job.gbw job.molden.input > OUTPUT_SHA256SUMS\ndate -u +%FT%TZ > completed.utc\n"
        },
