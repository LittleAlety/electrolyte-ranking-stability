# Virtual environments
.venv/
venv/
env/

# Python bytecode / caches
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/

# Quantum-chemistry scratch and outputs
# xTB / CREST write these next to the input; they are never inputs themselves.
xtbrestart
xtbtraj
xtb.out
xtbopt.xyz
xtbopt.log
xtbtopo.mol
.xtboptok
wbo
charges
crest_conformers.xyz
crest_best.xyz
crest.log
# ORCA scratch + outputs
*.gbw
*.bas*
*.densities
*.hostnames
*.opt
*.property.txt
*.restart
*.scfpcm
*.scfr
*.trj
*.tmp
*.out
!tests/**/*.out
!outputs/**/*.out
# Superseded trial runs kept out of the tree
outputs/_*/

# Local environment overrides (may hold absolute tool paths / tokens)
.env
.env.*
!.env.example

# OS noise
.DS_Store
Thumbs.db
desktop.ini

# Bundled local toolchain (xTB/CREST/ORCA binaries are large and re-downloadable)
.toolchain/
.mamba/
