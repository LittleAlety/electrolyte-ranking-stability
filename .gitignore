# Virtual environments
.venv/
venv/
env/

# Python bytecode / caches
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/

# Quantum-chemistry scratch and outputs
# xTB / CREST write these next to the input; they are never inputs themselves.
xtbrestart
xtbtraj
xtb.out
xtbopt.xyz
xtbopt.log
xtbtopo.mol
.xtboptok
wbo
charges
crest_conformers.xyz
crest_best.xyz
crest.log
# ORCA scratch + outputs
*.gbw
*.gbw0
*.bas*
*.densities
*.hostnames
*.opt
*.property.txt
*.restart
*.scfpcm
*.scfr
*.trj
*.tmp
# ORCA per-image / per-iteration scratch that is recreated by every NEB or CPCM
# run (hundreds of MB next to the one text output that matters).
*.cpcm
*.cpcm_corr
*.densitiesinfo
*.lastint
*.lastscf
*.tmp.*
*.out
!tests/**/*.out
!outputs/**/*.out
# Superseded trial runs kept out of the tree
outputs/_*/

# Local environment overrides (may hold absolute tool paths / tokens)
.env
.env.*
!.env.example

# OS noise
.DS_Store
Thumbs.db
desktop.ini

# Bundled local toolchain (xTB/CREST/ORCA binaries are large and re-downloadable)
.toolchain/
.mamba/

# WP2 生产生成器重打补丁时的备份（由 scripts/wp_production/emit_wp2.py 写出，不是产物）
*.bak-wp2
