+def _resolve_duplicate_to_weighted(origin, target, weights, dedup_rows, _seen=None):
+    """True only for a same-state duplicate chain ending at a weighted member.
+
+    Cross-state links are refused: a member of one state may not borrow another
+    state's representative.  Dangling targets and cycles are unresolved.
+    """
+    seen = set() if _seen is None else _seen
+    if not target or target in seen:
+        return False
+    if target.rsplit("|", 1)[0] != origin.rsplit("|", 1)[0]:
+        return False
+    if target in weights:
+        return True
+    seen.add(target)
+    d = dedup_rows.get(target)
+    nxt = (d or {}).get("duplicate_of") or ""
+    return _resolve_duplicate_to_weighted(origin, nxt, weights, dedup_rows, seen)
+
